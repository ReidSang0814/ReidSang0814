          "value": "{{created}}",
          "keyColor": "#0969da, #79c0ff"
        },
        {
          "key": "Uptime",
          "value": "{{uptime}}",
          "keyColor": "#0969da, #79c0ff"
        }
      ]
    },
    {
      "title": "- Links",
      "titleColor": {
        "text": "#0969da, #79c0ff",
        "line": "#d0d7de, #30363d"
      },
