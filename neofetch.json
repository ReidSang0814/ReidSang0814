          "value": "{{followers}}"
        },
        "right": {
          "key": "Following",
          "value": "{{following}}"
        }
      },
      {
        "left": {
          "key": "Issues",
          "value": "{{issues}}"
        },
        "right": {
          "key": "PRs",
          "value": "{{prs}}"
        }
      }
